# History and OS files
.Rhistory
.RData
.Rproj.user/
.DS_Store
Thumbs.db

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Data folders (ignore all 'data' or 'Data' directories across repo)
[Dd]ata/*
**/[Dd]ata/*
OAS_full/
DAT-DB-webapp/pepDB
DAT-DB-webapp/rsconnect
Archived/

# Keep shell and batch download scripts inside Data folders
!**/[Dd]ata/*.sh
!**/[Dd]ata/*.bat
!**/[Dd]ata/cRAP.fasta
!**/[Dd]ata/entrapment_cassettes.fasta
!**/[Dd]ata/OAS_metadata.csv

